variable EVM_ENTRY = core

evm {
  files
    prelude.sail,
    exceptions.sail,
    primitives/bytes.sail,
    primitives/rlp.sail,
    primitives/crypto.sail,
    primitives/fork.sail,
    primitives/chain_config.sail,
    primitives/account.sail,
    primitives/journal.sail,
    primitives/tx.sail,
    primitives/block.sail,
    primitives/evm.sail,
    primitives/stateless_input.sail,
    host/io.sail,
    lib/ssz.sail,
    lib/rlp/rlp.sail,
    lib/address.sail,
    lib/tx.sail,
    lib/rlp/tx.sail,
    lib/rlp/block.sail,
    host/state.sail,
    host/kernel.sail,
    host/stack.sail,
    host/frame_code.sail,
    host/memory.sail,
    host/returndata.sail,
    host/calldata.sail,
    evm/machine.sail,
    evm/gas.sail,
    evm/instructions.sail,
    evm/execute.sail,
    evm/interpreter.sail,
    evm/transaction.sail,
    lib/mpt.sail,
    lib/consensus_hash.sail,
    if $EVM_ENTRY == core then []
    else if $EVM_ENTRY == guest then [host/block.sail, lib/htr.sail, bin/main.sail]
    else if $EVM_ENTRY == runner then [host/block.sail, bin/runner.sail]
    else error("EVM_ENTRY must be core, guest, or runner")
}
