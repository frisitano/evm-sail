variable EVM_ENTRY = core

evm {
  files
    prelude.sail,
    exceptions.sail,
    primitives/bytes.sail,
    primitives/rlp.sail,
    primitives/crypto.sail,
    primitives/fork.sail,
    primitives/chain_config.sail,
    primitives/system.sail,
    primitives/account.sail,
    primitives/journal.sail,
    primitives/tx.sail,
    primitives/block.sail,
    primitives/evm.sail,
    primitives/stateless_input.sail,
    host/io.sail,
    host/byte_slice.sail,
    lib/ssz/ssz.sail,
    lib/rlp/rlp.sail,
    lib/address.sail,
    lib/tx.sail,
    lib/rlp/tx.sail,
    lib/rlp/block.sail,
    host/state.sail,
    host/environment.sail,
    host/stack.sail,
    host/memory.sail,
    host/returndata.sail,
    host/kernel/environment.sail,
    host/kernel/storage.sail,
    host/kernel/logs.sail,
    host/kernel/accounts.sail,
    host/kernel/code.sail,
    host/kernel/selfdestruct.sail,
    host/kernel/lifecycle.sail,
    evm/machine.sail,
    evm/gas.sail,
    evm/instructions.sail,
    evm/execute.sail,
    evm/interpreter.sail,
    evm/transaction.sail,
    lib/mpt.sail,
    lib/state_trie.sail,
    if $EVM_ENTRY == core then []
    else if $EVM_ENTRY == guest then [lib/ssz/stateless_input.sail, executor/system_calls.sail, executor/block.sail, lib/htr.sail, bin/main.sail]
    else if $EVM_ENTRY == runner then [lib/ssz/stateless_input.sail, bin/runner.sail]
    else error("EVM_ENTRY must be core, guest, or runner")
}
