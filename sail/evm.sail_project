variable EVM_ENTRY = core

evm {
  files
    prelude.sail,
    exceptions.sail,
    primitives/bytes.sail,
    primitives/crypto.sail,
    primitives/account.sail,
    primitives/journal.sail,
    primitives/tx.sail,
    primitives/block.sail,
    primitives/evm.sail,
    primitives/stateless_input.sail,
    host/io.sail,
    host/stateless_input.sail,
    lib/rlp.sail,
    host/state.sail,
    host/kernel.sail,
    host/stack.sail,
    host/frame_code.sail,
    host/memory.sail,
    host/returndata.sail,
    host/calldata.sail,
    evm/machine.sail,
    evm/gas.sail,
    evm/instructions.sail,
    evm/execute.sail,
    evm/interpreter.sail,
    evm/transaction.sail,
    lib/mpt.sail,
    host/bal.sail,
    lib/consensus_hash.sail,
    if $EVM_ENTRY == core then []
    else if $EVM_ENTRY == guest then [host/block.sail, lib/ssz_htr.sail, bin/main.sail]
    else if $EVM_ENTRY == runner then [host/block.sail, bin/runner.sail]
    else error("EVM_ENTRY must be core, guest, or runner")
}
