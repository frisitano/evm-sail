variable EVM_DEBUG = off

evm {
  files
    prelude.sail,
    primitives/quantities.sail,
    primitives/gas.sail,
    primitives/bytes.sail,
    exceptions.sail,
    evm/halt.sail,
    primitives/ssz.sail,
    primitives/code.sail,
    host/accelerators.sail,
    primitives/rlp.sail,
    host/region_access.sail,
    host/scratch.sail,
    kernel/scratch.sail,
    primitives/crypto.sail,
    primitives/fork.sail,
    primitives/chain_config.sail,
    primitives/system.sail,
    primitives/account.sail,
    primitives/tx.sail,
    primitives/block.sail,
    primitives/evm.sail,
    primitives/stateless_input.sail,
    host/code.sail,
    host/nodes.sail,
    lib/ssz/ssz.sail,
    lib/rlp/rlp.sail,
    lib/address.sail,
    lib/tx.sail,
    lib/rlp/tx.sail,
    host/state.sail,
    host/environment.sail,
    host/stack.sail,
    host/frame_stack.sail,
    host/memory.sail,
    host/output.sail,
    kernel/environment.sail,
    kernel/storage.sail,
    kernel/logs.sail,
    kernel/accounts.sail,
    kernel/code.sail,
    kernel/selfdestruct.sail,
    kernel/lifecycle.sail,
    evm/machine.sail,
    evm/gas.sail,
    evm/precompiles.sail,
    evm/instructions.sail,
    evm/execute.sail,
    evm/interpreter.sail,
    evm/transaction.sail,
    lib/mpt/primitives.sail,
    lib/mpt/nodes.sail,
    lib/mpt/updates.sail,
    lib/mpt/indexed.sail,
    lib/mpt/trie.sail,
    lib/state_trie.sail,
    if $EVM_DEBUG == off then host/debug_disabled.sail
    else if $EVM_DEBUG == on then host/debug_enabled.sail
    else error("EVM_DEBUG must be off or on"),
    lib/ssz/stateless_input.sail,
    executor/receipts.sail,
    executor/system_calls.sail,
    executor/block_access_list.sail,
    executor/block.sail,
    executor/payload.sail,
    executor/stateless.sail,
    lib/htr.sail,
    executor/result.sail,
    main.sail
}
